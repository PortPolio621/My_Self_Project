    "newArchEnabled": true,
    "icon": "./assets/images/logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mesoplanner.app"
    },
    "android": {
      "package": "com.mesoplanner.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#0F1220"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
